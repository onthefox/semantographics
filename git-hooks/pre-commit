#!/bin/sh
# ----------------------------------------------------------------------
# pre‑commit: block commits that contain a rare interpreter *and* SECRET_KEY
# ----------------------------------------------------------------------
# Get the list of staged files (added, copied, modified, renamed)
git diff --cached --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' path; do
    # Retrieve blob content from the index
    blob=$(git diff --cached -- "$path" | git apply --cached --reverse 2>/dev/null || git show ":$path" 2>/dev/null)
    if [ $? -eq 0 ]; then
        printf "%s\0%s\n" "$path" "$blob"
    else
        # Fallback to just path if blob retrieval fails
        printf "%s\n" "$path"
    fi
done | /opt/llm-suspicion-detector/git-hooks/check_commit.py
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "❌ Commit rejected – see messages above."
    exit 1
fi

exit 0
